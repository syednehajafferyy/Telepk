# Create a Resend account, verify a sender domain, and keep these values in .env.local.
RESEND_API_KEY=re_your_server_side_api_key
EMAIL_FROM=TeleX <verify@your-verified-domain.com>

# Configure one admin account; keep the real values in .env.local.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password